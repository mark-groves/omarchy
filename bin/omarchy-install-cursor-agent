#!/bin/bash

# omarchy:summary=Install Cursor Agent from Cursor's official Linux tarball
# omarchy:args=[--check]
# omarchy:hidden=true

# Cursor's documented CLI name is `agent`, but Omarchy stores and launches
# `cursor-agent` so it does not collide with other tools named agent. An asdf
# plugin is not used: that path is third-party bash that scrapes
# cursor.com/install and pipes curl into tar with no checksum.

set -euo pipefail

ASDF_STUB_MARK='asdf:icholy/asdf-cursor-agent'

cursor_agent_path() {
  command -v cursor-agent 2>/dev/null || true
}

cursor_agent_is_asdf_stub() {
  local path=$1

  [[ -f $path ]] && grep -Fq "$ASDF_STUB_MARK" "$path"
}

cursor_agent_ready() {
  local path
  path=$(cursor_agent_path)
  [[ -n $path ]] || return 1
  cursor_agent_is_asdf_stub "$path" && return 1
  return 0
}

remove_asdf_stub() {
  local path
  path=$(cursor_agent_path)
  [[ -n $path ]] || return 0
  cursor_agent_is_asdf_stub "$path" || return 0
  rm -f "$path"
}

case "${1:-}" in
--check)
  cursor_agent_ready
  ;;
-h | --help)
  echo "Usage: omarchy-install-cursor-agent [--check]"
  echo
  echo "Installs Cursor's official Linux CLI as cursor-agent if it is not already"
  echo "on PATH. --check exits 0 when a usable cursor-agent is present."
  ;;
"")
  remove_asdf_stub
  exec omarchy-update-cursor-agent --install
  ;;
*)
  echo "omarchy-install-cursor-agent: unknown option '$1'. Try --help." >&2
  exit 2
  ;;
esac
