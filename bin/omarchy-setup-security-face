#!/bin/bash

# omarchy:summary=Set up face authentication for lock, sudo, and system prompts
# omarchy:requires-sudo=true

set -euo pipefail

readonly MODULE=/usr/lib/security/pam_howdy.so
readonly HOWDY_HELPER_DROPIN=/usr/lib/systemd/system/polkit-agent-helper@.service.d/10-howdy.conf

as_root() {
  if (( EUID == 0 )); then
    "$@"
  else
    sudo "$@"
  fi
}

echo -e "\e[32mSetting up face authentication for lock, sudo, and system prompts.\n\e[0m"

if [[ ! -f $MODULE ]]; then
  echo -e "\e[31mhowdy-next is not installed ($MODULE is missing).\e[0m"
  exit 1
fi

if [[ ! -f $HOWDY_HELPER_DROPIN ]]; then
  echo -e "\e[31mMissing Howdy polkit camera drop-in:\n$HOWDY_HELPER_DROPIN\e[0m"
  exit 1
fi

echo "Howdy is installed. Enroll a face model with howdy if you have not already."
echo

echo "Configuring lock screen for face authentication..."
as_root tee /etc/pam.d/omarchy-lock-face >/dev/null <<'EOF'
#%PAM-1.0
auth       required                    pam_howdy.so
account    include                     system-local-login
EOF

echo "Configuring sudo for face authentication..."
omarchy-pam-pair-add /etc/pam.d/sudo pam_howdy.so

echo "Configuring polkit for face authentication..."
omarchy-apply-polkit-pam add face

echo -e "\e[32m\nFace authentication is now used for lock, sudo, and system prompts.\e[0m"
echo "Password remains the fallback. Look at the lid camera when asked."
echo "This command does not enroll. Change the face with howdy."
