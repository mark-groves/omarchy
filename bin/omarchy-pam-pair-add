#!/bin/bash

# omarchy:summary=Insert a PAM module and only its adjacent lid gate
# omarchy:group=apply
# omarchy:args=[--from FILE --print] FILE MODULE
# omarchy:requires-sudo=true
# omarchy:hidden=true

set -euo pipefail

if (( EUID == 0 )); then
  export PATH=/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin
fi

readonly GATE_HELPER=/usr/bin/omarchy-hw-laptop-closed
readonly EMITTER_HELPER=/usr/local/bin/omarchy-hw-ir-emitter
readonly EMITTER_LINE="auth      optional pam_exec.so quiet $EMITTER_HELPER"

gate_line() {
  printf 'auth      [success=%s default=ignore] pam_exec.so quiet %s' "$1" "$GATE_HELPER"
}

is_gate_line() {
  [[ $1 =~ ^[[:space:]]*auth[[:space:]]+ ]] && [[ $1 == *pam_exec.so* && $1 == *$GATE_HELPER* ]]
}

is_emitter_line() {
  [[ $1 =~ ^[[:space:]]*auth[[:space:]]+ ]] && [[ $1 == *pam_exec.so* && $1 == *$EMITTER_HELPER* ]]
}

is_header_line() {
  [[ $1 == '#%PAM-1.0' || $1 =~ ^#%PAM ]]
}

has_recovery_auth() {
  local line

  for line in "$@"; do
    [[ $line =~ ^[[:space:]]*auth[[:space:]]+ ]] || continue
    if [[ $line == *include*system-auth* || $line == *pam_unix.so* ]]; then
      return 0
    fi
  done
  return 1
}

emit_lines() {
  if ! has_recovery_auth "$@"; then
    echo "omarchy-pam-pair-add: refusing a sudo stack with no password recovery" >&2
    return 1
  fi
  printf '%s\n' "$@"
}

emit_pair_add() {
  local source=$1 module=$2
  local -a lines=() prefix=()
  local i method_line

  method_line="auth      sufficient $module"
  mapfile -t lines < "$source"

  if [[ $module == "pam_howdy.so" ]]; then
    prefix=("$(gate_line 2)" "$EMITTER_LINE")
  else
    prefix=("$(gate_line 1)")
  fi

  for i in "${!lines[@]}"; do
    if [[ ${lines[i]} == *"$module"* ]]; then
      if [[ $module == "pam_howdy.so" ]]; then
        if (( i >= 2 )) && is_emitter_line "${lines[i - 1]}" && is_gate_line "${lines[i - 2]}"; then
          emit_lines "${lines[@]}"
          return
        fi
        if (( i > 0 )) && is_gate_line "${lines[i - 1]}"; then
          emit_lines "${lines[@]:0:$((i - 1))}" "${prefix[@]}" "${lines[@]:i}"
          return
        fi
      elif (( i > 0 )) && is_gate_line "${lines[i - 1]}"; then
        emit_lines "${lines[@]}"
        return
      fi
      emit_lines "${lines[@]:0:i}" "${prefix[@]}" "${lines[@]:i}"
      return
    fi
  done

  if (( ${#lines[@]} > 0 )) && is_header_line "${lines[0]}"; then
    emit_lines "${lines[0]}" "${prefix[@]}" "$method_line" "${lines[@]:1}"
    return
  fi

  if (( ${#lines[@]} > 0 )); then
    emit_lines "${prefix[@]}" "$method_line" "${lines[@]}"
    return
  fi

  emit_lines "${prefix[@]}" "$method_line"
}

usage() {
  cat <<USAGE
Usage: omarchy-pam-pair-add FILE MODULE
       omarchy-pam-pair-add --from FILE --print MODULE

Inserts MODULE as sufficient with a lid-gate line immediately above it. pam_howdy.so also gets the IR emitter line between the gate and the module.
USAGE
}

as_root() {
  if (( EUID == 0 )); then
    "$@"
  else
    sudo "$@"
  fi
}

main() {
  local from="" print=0 file="" module=""

  while (( $# > 0 )); do
    case $1 in
      --from)
        [[ $# -ge 2 ]] || { usage >&2; exit 64; }
        from=$2
        shift 2
        ;;
      --print)
        print=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        if [[ -z $file && -z $from ]]; then
          file=$1
        elif [[ -z $module ]]; then
          module=$1
        else
          usage >&2
          exit 64
        fi
        shift
        ;;
    esac
  done

  if [[ -n $from ]]; then
    file=$from
    if (( print == 0 )); then
      echo "omarchy-pam-pair-add: --from requires --print" >&2
      exit 64
    fi
  fi

  if [[ -z $file || -z $module ]]; then
    usage >&2
    exit 64
  fi

  if [[ ! -f $file || -L $file ]]; then
    echo "omarchy-pam-pair-add: FILE must be a regular file" >&2
    exit 64
  fi

  if (( print )); then
    emit_pair_add "$file" "$module"
    exit 0
  fi

  local tmp
  tmp=$(as_root mktemp "$file.new.XXXXXX")
  emit_pair_add "$file" "$module" | as_root tee "$tmp" >/dev/null
  as_root chmod 644 "$tmp"
  as_root mv -Tf "$tmp" "$file"
}

main "$@"
