#!/bin/bash

# omarchy:summary=Returns a list of all the available power profiles on the system.
# omarchy:args=[--active-state]

if [[ ${1:-} != "" && ${1:-} != "--active-state" ]]; then
  echo "Usage: omarchy-powerprofiles-list [--active-state]" >&2
  exit 1
fi

profiles_json=$(busctl --json=short get-property \
  net.hadess.PowerProfiles \
  /net/hadess/PowerProfiles \
  net.hadess.PowerProfiles \
  Profiles 2>/dev/null) || exit 0

if [[ ${1:-} == "--active-state" ]]; then
  active=$(busctl --json=short get-property \
    net.hadess.PowerProfiles \
    /net/hadess/PowerProfiles \
    net.hadess.PowerProfiles \
    ActiveProfile 2>/dev/null | jq -r '.data // empty')
  jq -r --arg active "$active" \
    '.data[]?.Profile.data // empty | "\(.)\t\(if . == $active then 1 else 0 end)"' \
    <<<"$profiles_json"
else
  jq -r '.data[]?.Profile.data // empty' <<<"$profiles_json"
fi
