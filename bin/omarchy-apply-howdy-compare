#!/bin/bash

# omarchy:summary=Pin howdy-compare to one CPU
# omarchy:group=apply
# omarchy:args=install|remove [--root DIR]
# omarchy:requires-sudo=true
# omarchy:hidden=true

set -euo pipefail

if (( EUID == 0 )); then
  export PATH=/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin
fi

usage() {
  echo "Usage: omarchy-apply-howdy-compare install|remove [--root DIR]" >&2
}

print_wrapper() {
  cat <<'EOF'
#!/bin/bash -p
# Pinned to one CPU: howdy-compare's sandbox caps CPU time at 15 s while
# OpenCV uses every core. -p keeps euid 0 so compare can read the root-only
# Howdy config. Nothing else may run here.
export OMP_NUM_THREADS=1 OPENCV_FOR_THREADS_NUM=1 OPENCV_NUM_THREADS=1 OPENCV_LOG_LEVEL=ERROR
exec /usr/bin/taskset -c 0 /usr/lib/howdy/howdy-compare.real "$@"
EOF
}

# Earlier installs wrote this pacman hook to re-pin compare after every
# howdy-next upgrade. It ran this command from the Omarchy tree named in
# /etc/omarchy.conf, which on a linked checkout is user-writable code run as
# root. Install and remove now retire it; the text is kept to recognise it.
print_legacy_hook() {
  cat <<'EOF'
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/howdy/howdy-compare

[Action]
Description = Pinning howdy-compare to one CPU...
When = PostTransaction
# The command is resolved through the same file the rest of the system uses to
# find the Omarchy tree, because a linked checkout does not ship it in /usr/bin.
# Only a root-owned conf that nobody else can write may pick a root-run binary.
Exec = /usr/bin/bash -c 'conf=/etc/omarchy.conf; if [[ -e $conf || -L $conf ]]; then [[ -f $conf && ! -L $conf && $(stat -c %u:%a -- "$conf") =~ ^0:[0-7][0145][0145]$ ]] || { echo "$conf must be a root-owned file that only root can write" >&2; exit 1; }; . "$conf"; fi; exec "${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-apply-howdy-compare" install'
EOF
}

is_regular_file() {
  [[ -f $1 && ! -L $1 ]]
}

is_elf() {
  local path=$1
  local magic

  is_regular_file "$path" || return 1
  magic=$(head -c 4 -- "$path")
  [[ $magic == $'\x7fELF' ]]
}

is_wrapper() {
  local path=$1
  local first

  is_regular_file "$path" || return 1
  first=""
  IFS= read -r first <"$path" || true
  [[ $first == "#!"* ]]
}

slot_state() {
  if [[ ! -e $compare ]]; then
    printf '%s\n' absent
    return
  fi
  if is_elf "$compare"; then
    printf '%s\n' vendor
    return
  fi
  if is_wrapper "$compare"; then
    if is_elf "$real"; then
      printf '%s\n' pinned
      return
    fi
  fi
  printf '%s\n' unknown
}

# The wrapper earlier installs wrote ran this helper from the Omarchy tree as
# root before authentication. It is replaced in any slot state, even one whose
# .real is gone, because what it runs is the hole.
is_signalling_wrapper() {
  is_wrapper "$compare" && grep -Fq 'omarchy-face-auth-signal' "$compare"
}

refuse_unknown() {
  echo "howdy-compare is in an unknown state" >&2
  exit 1
}

stage_write() {
  local dest=$1
  local mode=$2
  local tmp

  tmp=$(mktemp "$dest.new.XXXXXX")
  cat >"$tmp"
  chmod "$mode" "$tmp"
  mv -Tf "$tmp" "$dest"
}

# The vendor binary keeps its own mode, owner, and xattrs (file capabilities
# live there) on the way to .real and back.
stage_copy() {
  local src=$1
  local dest=$2
  local tmp

  tmp=$(mktemp "$dest.new.XXXXXX")
  cp -a -- "$src" "$tmp"
  mv -Tf "$tmp" "$dest"
}

write_wrapper() {
  print_wrapper | stage_write "$compare" 755
}

# The shipped hook is deleted. One that was edited by hand is kept, but under
# a name pacman does not load.
retire_hook() {
  [[ -e $hook || -L $hook ]] || return 0
  if is_regular_file "$hook" && cmp -s -- "$hook" <(print_legacy_hook); then
    rm -f -- "$hook"
    echo "Removing the howdy-compare upgrade hook..."
  else
    mv -Tf -- "$hook" "$hook.retired"
    echo "Moved a modified howdy-compare upgrade hook to $hook.retired"
  fi
}

install_pin() {
  local state
  retire_hook
  state=$(slot_state)

  case $state in
    vendor)
      stage_copy "$compare" "$real"
      write_wrapper
      echo "Pinning howdy-compare to one CPU..."
      ;;
    pinned)
      if [[ -f $compare ]] && cmp -s -- "$compare" <(print_wrapper); then
        echo "howdy-compare pin already in place"
      else
        write_wrapper
        echo "Updating howdy-compare pin..."
      fi
      ;;
    absent)
      if [[ -e $real ]]; then
        rm -f -- "$real"
        echo "Removing leftover howdy-compare.real"
      fi
      ;;
    unknown)
      if is_signalling_wrapper; then
        write_wrapper
        echo "Replaced the howdy-compare wrapper that ran Omarchy code as root" >&2
      fi
      refuse_unknown
      ;;
  esac
}

remove_pin() {
  local state
  retire_hook
  state=$(slot_state)

  case $state in
    pinned)
      stage_copy "$real" "$compare"
      rm -f -- "$real"
      echo "Restoring vendor howdy-compare..."
      ;;
    vendor)
      ;;
    absent)
      if [[ -e $real ]]; then
        rm -f -- "$real"
        echo "Removing leftover howdy-compare.real"
      fi
      ;;
    unknown)
      refuse_unknown
      ;;
  esac
}

action=""
root=""
have_root=0

while (( $# > 0 )); do
  case $1 in
    install|remove)
      if [[ -n $action ]]; then
        usage
        exit 1
      fi
      action=$1
      shift
      ;;
    --root)
      if (( $# < 2 )); then
        usage
        exit 1
      fi
      root=$2
      have_root=1
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

if [[ -z $action ]]; then
  usage
  exit 1
fi

if (( have_root == 0 )) && (( EUID != 0 )); then
  echo "run as root" >&2
  exit 1
fi

compare="$root/usr/lib/howdy/howdy-compare"
real="$root/usr/lib/howdy/howdy-compare.real"
hook="$root/etc/pacman.d/hooks/omarchy-howdy-compare.hook"

if [[ $action == "install" ]]; then
  install_pin
else
  remove_pin
fi
