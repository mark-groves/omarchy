#!/bin/bash

# omarchy:summary=Pin howdy-compare to one CPU and keep the pin across howdy-next upgrades
# omarchy:group=apply
# omarchy:args=install|remove [--root DIR]
# omarchy:requires-sudo=true
# omarchy:hidden=true

set -euo pipefail

if (( EUID == 0 )); then
  export PATH=/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin
fi

usage() {
  echo "Usage: omarchy-apply-howdy-compare install|remove [--root DIR]" >&2
}

print_wrapper() {
  cat <<'EOF'
#!/bin/bash -p
# pam_howdy spawns this with an empty environment, and howdy-compare's sandbox
# caps CPU time at 15 s while OpenCV uses every core. One CPU keeps CPU time
# equal to wall time. -p keeps euid 0 under sudo, which bash would otherwise
# drop to the caller and leave compare unable to read the Howdy config.
# OPENCV_LOG_LEVEL=ERROR drops the DNN graph-engine WARN lines without hiding
# real OpenCV errors. Compare is the process that prints them.
export OMP_NUM_THREADS=1 OPENCV_FOR_THREADS_NUM=1 OPENCV_NUM_THREADS=1
export OPENCV_LOG_LEVEL=ERROR

# Tell the session shell a scan started or finished. Display-only: never
# change compare's exit status, and never write to stdout (Howdy owns that).
# A cancelled or killed sudo must still hide the card: scanning opens it and
# recognized / notRecognized only run on a normal compare exit.
signaled_result=0
signal_face() {
  local conf=/etc/omarchy.conf
  local omarchy_path=/usr/share/omarchy
  local helper
  if [[ -f $conf && ! -L $conf && $(/usr/bin/stat -c %u:%a -- "$conf") =~ ^0:[0-7][0145][0145]$ ]]; then
    # shellcheck disable=SC1090
    . "$conf"
    omarchy_path=${OMARCHY_PATH:-/usr/share/omarchy}
  fi
  helper=$omarchy_path/bin/omarchy-face-auth-signal
  [[ -x $helper ]] || return 0
  "$helper" "$1" >/dev/null 2>&1 || true
}

signal_result() {
  signaled_result=1
  signal_face "$1"
}

on_exit() {
  if (( signaled_result == 0 )); then
    signal_face cancelled
  fi
}

trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

signal_face scanning
/usr/bin/taskset -c 0 /usr/lib/howdy/howdy-compare.real "$@"
status=$?
if (( status == 0 )); then
  signal_result recognized
else
  signal_result notRecognized
fi
exit $status
EOF
}

print_hook() {
  cat <<'EOF'
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/howdy/howdy-compare

[Action]
Description = Pinning howdy-compare to one CPU...
When = PostTransaction
# The command is resolved through the same file the rest of the system uses to
# find the Omarchy tree, because a linked checkout does not ship it in /usr/bin.
# Only a root-owned conf that nobody else can write may pick a root-run binary.
Exec = /usr/bin/bash -c 'conf=/etc/omarchy.conf; if [[ -e $conf || -L $conf ]]; then [[ -f $conf && ! -L $conf && $(stat -c %u:%a -- "$conf") =~ ^0:[0-7][0145][0145]$ ]] || { echo "$conf must be a root-owned file that only root can write" >&2; exit 1; }; . "$conf"; fi; exec "${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-apply-howdy-compare" install'
EOF
}

is_regular_file() {
  [[ -f $1 && ! -L $1 ]]
}

is_elf() {
  local path=$1
  local magic

  is_regular_file "$path" || return 1
  magic=$(head -c 4 -- "$path")
  [[ $magic == $'\x7fELF' ]]
}

is_wrapper() {
  local path=$1
  local first

  is_regular_file "$path" || return 1
  first=""
  IFS= read -r first <"$path" || true
  [[ $first == "#!"* ]]
}

slot_state() {
  if [[ ! -e $compare ]]; then
    printf '%s\n' absent
    return
  fi
  if is_elf "$compare"; then
    printf '%s\n' vendor
    return
  fi
  if is_wrapper "$compare"; then
    if is_elf "$real"; then
      printf '%s\n' pinned
      return
    fi
  fi
  printf '%s\n' unknown
}

refuse_unknown() {
  echo "howdy-compare is in an unknown state" >&2
  exit 1
}

stage_write() {
  local dest=$1
  local mode=$2
  local tmp

  tmp=$(mktemp "$dest.new.XXXXXX")
  cat >"$tmp"
  chmod "$mode" "$tmp"
  mv -Tf "$tmp" "$dest"
}

# The vendor binary keeps its own mode, owner, and xattrs (file capabilities
# live there) on the way to .real and back.
stage_copy() {
  local src=$1
  local dest=$2
  local tmp

  tmp=$(mktemp "$dest.new.XXXXXX")
  cp -a -- "$src" "$tmp"
  mv -Tf "$tmp" "$dest"
}

write_wrapper() {
  print_wrapper | stage_write "$compare" 755
}

write_hook() {
  mkdir -p "$(dirname -- "$hook")"
  if [[ -f $hook ]] && cmp -s -- "$hook" <(print_hook); then
    return 0
  fi
  print_hook | stage_write "$hook" 644
  echo "Installing howdy-compare upgrade hook..."
}

install_pin() {
  local state
  state=$(slot_state)

  case $state in
    vendor)
      stage_copy "$compare" "$real"
      write_wrapper
      echo "Pinning howdy-compare to one CPU..."
      write_hook
      ;;
    pinned)
      if [[ -f $compare ]] && cmp -s -- "$compare" <(print_wrapper); then
        echo "howdy-compare pin already in place"
      else
        write_wrapper
        echo "Updating howdy-compare pin..."
      fi
      write_hook
      ;;
    absent)
      if [[ -e $real ]]; then
        rm -f -- "$real"
        echo "Removing leftover howdy-compare.real"
      fi
      ;;
    unknown)
      refuse_unknown
      ;;
  esac
}

remove_pin() {
  local state
  state=$(slot_state)

  case $state in
    pinned)
      stage_copy "$real" "$compare"
      rm -f -- "$real"
      echo "Restoring vendor howdy-compare..."
      ;;
    vendor)
      ;;
    absent)
      if [[ -e $real ]]; then
        rm -f -- "$real"
        echo "Removing leftover howdy-compare.real"
      fi
      ;;
    unknown)
      refuse_unknown
      ;;
  esac

  if [[ -e $hook ]]; then
    rm -f -- "$hook"
    echo "Removing howdy-compare upgrade hook..."
  fi
}

action=""
root=""
have_root=0

while (( $# > 0 )); do
  case $1 in
    install|remove)
      if [[ -n $action ]]; then
        usage
        exit 1
      fi
      action=$1
      shift
      ;;
    --root)
      if (( $# < 2 )); then
        usage
        exit 1
      fi
      root=$2
      have_root=1
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

if [[ -z $action ]]; then
  usage
  exit 1
fi

if (( have_root == 0 )) && (( EUID != 0 )); then
  echo "run as root" >&2
  exit 1
fi

compare="$root/usr/lib/howdy/howdy-compare"
real="$root/usr/lib/howdy/howdy-compare.real"
hook="$root/etc/pacman.d/hooks/omarchy-howdy-compare.hook"

if [[ $action == "install" ]]; then
  install_pin
else
  remove_pin
fi
