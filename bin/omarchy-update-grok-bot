#!/bin/bash

# omarchy:summary=Update Grok Bot from the official Linux release when a newer one is available
# omarchy:name=grok-bot
# omarchy:requires-sudo=true

set -euo pipefail

DOWNLOAD_PAGE="https://cursor.com/download/bot"

latest_version=""
latest_deb_url=""

installed_pkgver() {
  local full
  full=$(pacman -Q grok-bot | awk '{print $2}')
  printf '%s\n' "${full%-*}"
}

probe_deb() {
  curl -fsI --retry 2 --max-time 20 "$1" >/dev/null
}

deb_url_from_build() {
  local download_base=$1 build_id=$2 version=$3
  local candidate

  for candidate in \
    "${download_base}/${build_id}/linux/${linux_dir}/grok-bot_${version}_${deb_arch}.deb" \
    "${download_base}/${build_id}/linux/${linux_dir}/Grok_Bot_${version}.deb"; do
    if probe_deb "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

resolve_from_feed() {
  local response url download_base build_id version resolved

  response=$(curl -fsSL --retry 3 --retry-all-errors --max-time 20 \
    "https://api2.cursor.sh/updates/api/update/${platform}/sand/0.0.1/a1b3c5d7-e9f0-4a2b-8c1d-3e5f7a9b0c2d/stable") || return 1

  version=$(jq -er '.version // .name // .productVersion' <<<"$response") || return 1
  url=$(jq -er '.url' <<<"$response") || return 1

  if [[ ! $url =~ downloads\.cursor\.com/([a-z0-9-]+)/stable/([0-9a-f]{40})/ ]]; then
    return 1
  fi

  download_base="https://downloads.cursor.com/${BASH_REMATCH[1]}/stable"
  build_id=${BASH_REMATCH[2]}
  resolved=$(deb_url_from_build "$download_base" "$build_id" "$version") || return 1

  latest_version=$version
  latest_deb_url=$resolved
}

resolve_from_download_page() {
  local html url version

  html=$(curl -fsSL --retry 3 --retry-all-errors --max-time 20 "$DOWNLOAD_PAGE") || return 1
  url=$(grep -oE "https://downloads\\.cursor\\.com/grokbot/stable/[0-9a-f]+/linux/${linux_dir}/grok-bot_[0-9.]+_${deb_arch}\\.deb" <<<"$html" | head -1)
  [[ -n $url ]] || return 1

  version=$(sed -n "s|.*/grok-bot_\\([^/]*\\)_${deb_arch}\\.deb$|\\1|p" <<<"$url")
  [[ $version =~ ^[0-9] ]] || return 1
  probe_deb "$url" || return 1

  latest_version=$version
  latest_deb_url=$url
}

pick_newer_release() {
  local feed_version="" feed_url="" page_version="" page_url=""

  if resolve_from_feed; then
    feed_version=$latest_version
    feed_url=$latest_deb_url
  fi

  latest_version=""
  latest_deb_url=""

  if resolve_from_download_page; then
    page_version=$latest_version
    page_url=$latest_deb_url
  fi

  if [[ -n $feed_version && -n $page_version ]]; then
    if (( $(vercmp "$page_version" "$feed_version") > 0 )); then
      latest_version=$page_version
      latest_deb_url=$page_url
    else
      latest_version=$feed_version
      latest_deb_url=$feed_url
    fi
  elif [[ -n $feed_version ]]; then
    latest_version=$feed_version
    latest_deb_url=$feed_url
  elif [[ -n $page_version ]]; then
    latest_version=$page_version
    latest_deb_url=$page_url
  else
    return 1
  fi
}

write_pkgbuild() {
  local pkgver=$1 deb_name=$2

  cat >PKGBUILD <<EOF
pkgname=grok-bot
pkgver=${pkgver}
pkgrel=1
pkgdesc="Grok Bot desktop agent"
arch=('${pkg_arch}')
url="https://cursor.com/download/bot"
license=('custom')
depends=(
  at-spi2-core
  gtk3
  hicolor-icon-theme
  libnotify
  libsecret
  libxss
  libxtst
  nss
  util-linux-libs
  xdg-utils
)
optdepends=('libappindicator-gtk3: tray support')
provides=('sand')
conflicts=('sand')
source=('${deb_name}')
noextract=('${deb_name}')
options=('!debug' '!strip')
sha256sums=('SKIP')

package() {
  bsdtar -xf "\$srcdir/${deb_name}" -C "\$srcdir"
  bsdtar -xf "\$srcdir"/data.tar.* -C "\$pkgdir"

  if [[ ! -x "\$pkgdir/opt/Grok Bot/grok-bot" && ! -x "\$pkgdir/opt/Grok Bot/sand" ]]; then
    echo "Official Grok Bot package did not contain the expected /opt/Grok Bot binary" >&2
    return 1
  fi

  install -dm755 "\$pkgdir/usr/bin"
  cat >"\$pkgdir/usr/bin/grok-bot" <<'WRAP'
#!/bin/bash

XDG_CONFIG_HOME=\${XDG_CONFIG_HOME:-~/.config}

export ELECTRON_OZONE_PLATFORM_HINT="\${ELECTRON_OZONE_PLATFORM_HINT:-wayland}"
export NIXOS_OZONE_WL="\${NIXOS_OZONE_WL:-1}"

if [[ -f \$XDG_CONFIG_HOME/grok-bot-flags.conf ]]; then
  GROK_BOT_USER_FLAGS="\$(sed 's/#.*//' "\$XDG_CONFIG_HOME/grok-bot-flags.conf" | tr '\n' ' ')"
fi

if [[ -x "/opt/Grok Bot/grok-bot" ]]; then
  GROK_BOT_BIN="/opt/Grok Bot/grok-bot"
else
  GROK_BOT_BIN="/opt/Grok Bot/sand"
fi

exec "\$GROK_BOT_BIN" \\
  --ozone-platform=wayland \\
  --enable-features=UseOzonePlatform,WaylandWindowDecorations \\
  --enable-wayland-ime \\
  "\$@" \$GROK_BOT_USER_FLAGS
WRAP
  chmod 755 "\$pkgdir/usr/bin/grok-bot"
  ln -sfn grok-bot "\$pkgdir/usr/bin/sand"

  local desktop
  for desktop in "\$pkgdir"/usr/share/applications/*.desktop; do
    [[ -f \$desktop ]] || continue
    sed -i 's|^Exec=.*|Exec=grok-bot %U|' "\$desktop"
  done

  if [[ -f "\$pkgdir/opt/Grok Bot/chrome-sandbox" ]]; then
    chmod 4755 "\$pkgdir/opt/Grok Bot/chrome-sandbox"
  fi

  if [[ -f "\$pkgdir/opt/Grok Bot/LICENSE.electron.txt" ]]; then
    install -Dm644 "\$pkgdir/opt/Grok Bot/LICENSE.electron.txt" \\
      "\$pkgdir/usr/share/licenses/grok-bot/LICENSE.electron.txt"
  fi
}
EOF
}

install_official_release() {
  local work deb_name pkg pkgs
  work=$(mktemp -d)

  deb_name=${latest_deb_url##*/}
  if ! (
    cd "$work"
    echo "Downloading Grok Bot ${latest_version}..."
    curl -fL --retry 3 --retry-all-errors --output "$deb_name" "$latest_deb_url"
    write_pkgbuild "$latest_version" "$deb_name"
    PKGDEST="$work" makepkg -f --noconfirm --nodeps
  ); then
    rm -rf "$work"
    return 1
  fi

  shopt -s nullglob
  pkgs=("$work"/grok-bot-${latest_version}-*.pkg.tar.*)
  shopt -u nullglob
  if (( ${#pkgs[@]} != 1 )); then
    rm -rf "$work"
    echo "Failed to build an Arch package from the official Grok Bot release" >&2
    return 1
  fi
  pkg=${pkgs[0]}

  if (( EUID == 0 )); then
    pacman -U --noconfirm "$pkg"
  else
    sudo pacman -U --noconfirm "$pkg"
  fi

  rm -rf "$work"
}

if omarchy-pkg-present grok-bot; then
  echo -e "\e[32m\nUpdate Grok Bot\e[0m"

  case $(uname -m) in
  x86_64)
    platform=linux-x64
    linux_dir=x64
    deb_arch=amd64
    pkg_arch=x86_64
    ;;
  aarch64)
    platform=linux-arm64
    linux_dir=arm64
    deb_arch=arm64
    pkg_arch=aarch64
    ;;
  *)
    echo "Official Grok Bot Linux builds are not published for $(uname -m); skipping."
    ;;
  esac

  if [[ -n ${platform:-} ]]; then
    if ! pick_newer_release; then
      echo "Could not reach official Grok Bot releases; skipping."
    else
      installed=$(installed_pkgver)
      if (( $(vercmp "$latest_version" "$installed") > 0 )); then
        echo "Official Grok Bot ${latest_version} is newer than installed ${installed}."
        install_official_release
        echo "Grok Bot updated to ${latest_version}."
        if pgrep -f '/opt/Grok Bot/(grok-bot|sand)' >/dev/null 2>&1; then
          echo "Restart Grok Bot to use the new version."
        fi
        omarchy-notification-send -u normal -g 󰚩 "Grok Bot updated" \
          "Updated from ${installed} to ${latest_version}." || true
      else
        echo "Grok Bot is already current (${installed})."
      fi
    fi
  fi
fi
