#!/bin/bash

# omarchy:summary=Remove face authentication from lock, sudo, and system prompts
# omarchy:requires-sudo=true

set -euo pipefail

# This runs in a terminal, where sudo can ask for the password. The whole
# script runs as root from here, and tests each stack as the invoking user.
if (( EUID != 0 )); then
  exec sudo "$(readlink -f -- "${BASH_SOURCE[0]}")" "$@"
fi

script_bin=$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")
export PATH="$script_bin:/usr/bin:/bin"
unset TMPDIR
source "$script_bin/omarchy-security-face-functions"

face_start

echo -e "\e[32mRemoving face authentication from lock, sudo, and system prompts.\n\e[0m"
echo "Each stack is tested as $face_user right after face is taken out, and put back if a check fails."

# Nothing is written until both stacks are shapes the writer can take face out of.
face_read_shape polkit-1 off
face_read_shape sudo off

face_convert polkit-1 off "sudo was not changed."
face_convert sudo off "System prompts stay without face."
echo

echo "Removing lock screen face authentication..."
face_apply lane remove

echo "Removing the face helpers..."
face_apply helpers remove

face_delete_old_emitter

"$script_bin/omarchy-apply-howdy-compare" remove

echo -e "\e[32mFace authentication has been removed from lock, sudo, and system prompts.\e[0m"
echo "Password is still the way in. Howdy models are unchanged."
