#!/usr/bin/python3 -I

# omarchy:summary=Fire the IR emitter on cameras that need a UVC control before a face scan
# omarchy:args=[--sysfs DIR --print|--sysfs DIR --dev DIR]
# omarchy:hidden=true

"""Fire the IR emitter immediately before a face scan.

The Bison 5986:1195 emitter resets to off on USB autosuspend, so a boot
oneshot cannot hold it. This command runs from PAM on every scan: as root
under sudo (euid 0) and in polkit's helper service, and as the user on the
lock screen. -I keeps PYTHON* variables, the user site and the script's own
directory out of the interpreter. The device nodes are opened first and the
process then drops to nobody with no groups, so no ioctl runs as root.

--sysfs and --dev are a test seam: a fake sysfs either prints its matches or
fires at a fake device directory, never at the real /dev.
"""
import ctypes, fcntl, glob, os, signal, sys

UVCIOC_CTRL_QUERY, GET_LEN, SET_CUR = 0xC0107521, 0x85, 0x01
NOBODY = 65534
# The whole run takes about 21 ms. A stalled driver must not hold a login.
WATCHDOG_SECONDS = 2
# (idVendor, idProduct, bInterfaceNumber): the RGB and IR sensors of one camera
# share a USB device and differ only by interface.
CONTROLS = {("5986", "1195", "02"): [{"unit": 14, "selector": 6, "value": [1, 3, 2, 0, 0, 0, 0, 0, 0]}]}


class XuQuery(ctypes.Structure):
    _fields_ = [("unit", ctypes.c_uint8), ("selector", ctypes.c_uint8),
                ("query", ctypes.c_uint8), ("size", ctypes.c_uint16),
                ("data", ctypes.POINTER(ctypes.c_uint8))]


def usage():
    print("Usage: omarchy-hw-ir-emitter [--sysfs DIR --print|--sysfs DIR --dev DIR]", file=sys.stderr)


def drop_privileges():
    # The lock screen already runs this as the user. Under sudo the real uid is
    # the user but the effective and saved ids are root, so all three go.
    # polkit's helper service is root and keeps the capabilities and the
    # @setuid syscalls this needs.
    if os.geteuid() != 0:
        return True
    try:
        os.setgroups([])
        os.setresgid(NOBODY, NOBODY, NOBODY)
        os.setresuid(NOBODY, NOBODY, NOBODY)
    except OSError:
        return False
    return os.getresuid() == (NOBODY,) * 3 and os.getresgid() == (NOBODY,) * 3 and not os.getgroups()


def matches(sysfs):
    for node in sorted(glob.glob(os.path.join(sysfs, "class/video4linux/video*"))):
        try:
            ids = (
                open(os.path.join(node, "device", "..", "idVendor")).read().strip().lower(),
                open(os.path.join(node, "device", "..", "idProduct")).read().strip().lower(),
                open(os.path.join(node, "device", "bInterfaceNumber")).read().strip().lower(),
            )
        except OSError:
            continue
        if ids in CONTROLS:
            yield os.path.basename(node), CONTROLS[ids]


def xu(fd, unit, selector, query, size, data=None):
    buf = (ctypes.c_uint8 * size)()
    if data:
        for i, b in enumerate(data):
            buf[i] = b
    q = XuQuery(unit, selector, query, size, ctypes.cast(buf, ctypes.POINTER(ctypes.c_uint8)))
    fcntl.ioctl(fd, UVCIOC_CTRL_QUERY, q)
    return list(buf)


def main(argv):
    sysfs, dev, do_print, i = None, None, False, 0
    while i < len(argv):
        if argv[i] == "--print":
            do_print, i = True, i + 1
        elif argv[i] in ("--sysfs", "--dev") and i + 1 < len(argv):
            if argv[i] == "--sysfs":
                sysfs = argv[i + 1]
            else:
                dev = argv[i + 1]
            i += 2
        else:
            usage()
            return 64
    # Compare resolved paths, so /dev/, //dev or a link to /dev is still /dev.
    real_dev = dev is None or os.path.realpath(dev) == os.path.realpath("/dev")
    if dev is not None and (sysfs is None or real_dev):
        usage()
        return 64
    if sysfs is not None and real_dev and not do_print:
        usage()
        return 64
    # Each default on its own, so a --dev that was given is never swapped for
    # the real /dev.
    if sysfs is None:
        sysfs = "/sys"
    if dev is None:
        dev = "/dev"
    if do_print:
        for name, controls in matches(sysfs):
            for c in controls:
                value = ",".join(str(b) for b in c["value"])
                print(f"{name} unit={c['unit']} selector={c['selector']} value={value}")
        return 0
    signal.signal(signal.SIGALRM, lambda *_: os._exit(0))
    signal.alarm(WATCHDOG_SECONDS)
    opened = []
    try:
        for name, controls in matches(sysfs):
            try:
                opened.append((os.open(os.path.join(dev, name), os.O_RDWR | os.O_NONBLOCK), controls))
            except OSError:
                continue
        # The open file keeps its access after the drop. A drop that does not
        # land fires nothing.
        if drop_privileges():
            for fd, controls in opened:
                for c in controls:
                    try:
                        n = xu(fd, c["unit"], c["selector"], GET_LEN, 2)[0]
                        vals = list(c["value"]) + [0] * (n - len(c["value"]))
                        xu(fd, c["unit"], c["selector"], SET_CUR, n, vals[:n])
                    except OSError:
                        continue
    except OSError:
        pass
    finally:
        for fd, _ in opened:
            os.close(fd)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
