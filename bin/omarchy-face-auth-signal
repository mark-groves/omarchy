#!/bin/bash

# omarchy:summary=Tell the running shell a face scan started or finished
# omarchy:args=scanning|recognized|notRecognized|cancelled [--runtime-dir DIR]
# omarchy:hidden=true

set -euo pipefail

# Display-only. PAM and howdy-compare must keep working if the session
# socket, runtime dir, or shell is missing. Bad arguments still fail so a
# caller that misspells a state notices in tests.

export PATH="/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin${PATH:+:$PATH}"

usage() {
  echo "Usage: omarchy-face-auth-signal scanning|recognized|notRecognized|cancelled [--runtime-dir DIR]" >&2
}

state=""
runtime_dir=""
have_runtime=0

while (( $# > 0 )); do
  case $1 in
    scanning|recognized|notRecognized|cancelled)
      if [[ -n $state ]]; then
        usage
        exit 64
      fi
      state=$1
      shift
      ;;
    --runtime-dir)
      if (( $# < 2 )); then
        usage
        exit 64
      fi
      runtime_dir=$2
      have_runtime=1
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 64
      ;;
  esac
done

if [[ -z $state ]]; then
  usage
  exit 64
fi

unset_loginuid=4294967295

# PAM howdy runs this as euid 0 with an empty environment. loginuid is the
# authenticating user. Guessing /run/user/* + Wayland can land in another
# person's session on a shared host, so an unset loginuid is a skip.
login_uid() {
  local uid=""
  [[ -r /proc/self/loginuid ]] || return 1
  uid=$(< /proc/self/loginuid)
  [[ $uid =~ ^[0-9]+$ ]] || return 1
  (( uid != unset_loginuid && uid != 0 )) || return 1
  printf '%s\n' "$uid"
}

session_runtime() {
  local uid=""
  if (( EUID != 0 )); then
    printf '%s\n' "${XDG_RUNTIME_DIR:-/run/user/$EUID}"
    return 0
  fi
  uid=$(login_uid) || return 0
  printf '%s\n' "/run/user/$uid"
}

# lstat: a symlink is not a writable session dir. Mode keeps group/other
# from planting a replacement between the check and the write.
owned_dir_ok() {
  local path=$1
  local owner=$2
  local meta
  [[ -d $path && ! -L $path ]] || return 1
  meta=$(/usr/bin/stat -c '%u:%a' -- "$path" 2>/dev/null) || return 1
  [[ $meta =~ ^${owner}:[0-7][0145][0145]$ ]]
}

if (( have_runtime == 0 )); then
  runtime_dir=$(session_runtime || true)
fi

if [[ -z $runtime_dir ]]; then
  exit 0
fi

# The user owns /run/user/$loginuid. mkdir -p and mktemp follow a planted
# omarchy symlink, and that would be a root write outside the session dir
# before PAM has decided. Skip instead of following.
if [[ -L $runtime_dir || ! -d $runtime_dir ]]; then
  exit 0
fi

expected_owner=$EUID
if (( EUID == 0 )); then
  if (( have_runtime == 0 )); then
    expected_owner=$(login_uid) || exit 0
  else
    expected_owner=$(/usr/bin/stat -c '%u' -- "$runtime_dir" 2>/dev/null) || exit 0
  fi
  owned_dir_ok "$runtime_dir" "$expected_owner" || exit 0
fi

dir=$runtime_dir/omarchy
if [[ -L $dir ]]; then
  exit 0
fi

if [[ ! -e $dir ]]; then
  # Root does not create a directory in a user-owned runtime tree. The
  # session overlay already made omarchy/. A missing dir is a skip.
  if (( EUID == 0 )) && (( expected_owner != 0 )); then
    exit 0
  fi
  mkdir -- "$dir" 2>/dev/null || exit 0
fi

if [[ -L $dir || ! -d $dir ]]; then
  exit 0
fi

if (( EUID == 0 )) && ! owned_dir_ok "$dir" "$expected_owner"; then
  exit 0
fi

# mktemp closes the fd. The session user owns $dir and can replace that
# name with a symlink before the write. Root must not follow it. Drop to
# the session owner for mktemp through mv; a planted symlink is then
# their write, not a privileged one. Skip if we cannot drop.
if (( EUID == 0 && expected_owner != 0 )); then
  gid=$(/usr/bin/stat -c '%g' -- "$dir") || exit 0
  [[ $gid =~ ^[0-9]+$ ]] || exit 0
  self=$0
  if [[ $self != /* ]]; then
    self=$(command -v -- "$0" 2>/dev/null) || exit 0
  fi
  /usr/bin/setpriv --reuid="$expected_owner" --regid="$gid" --clear-groups -- \
    /usr/bin/bash -- "$self" "$state" --runtime-dir "$runtime_dir" || true
  exit 0
fi

ts=${EPOCHREALTIME/./}
payload=$(printf '{"state":"%s","ts":%s}\n' "$state" "$ts")
tmp=$(mktemp -- "$dir/face-auth.json.XXXXXX" 2>/dev/null) || exit 0
if [[ -L $dir ]]; then
  rm -f -- "$tmp"
  exit 0
fi
if (( EUID == 0 )) && ! owned_dir_ok "$dir" "$expected_owner"; then
  rm -f -- "$tmp"
  exit 0
fi
if ! printf '%s' "$payload" >"$tmp" 2>/dev/null; then
  rm -f -- "$tmp"
  exit 0
fi
chmod 644 -- "$tmp" 2>/dev/null || true
if [[ -L $dir ]]; then
  rm -f -- "$tmp"
  exit 0
fi
if ! mv -Tf -- "$tmp" "$dir/face-auth.json" 2>/dev/null; then
  rm -f -- "$tmp"
fi
exit 0
