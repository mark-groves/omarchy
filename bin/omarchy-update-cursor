#!/bin/bash

# omarchy:summary=Update every installed Cursor product from its official release
# omarchy:name=cursor
# omarchy:args=[--check]

set -uo pipefail

CURSOR_PRODUCTS=(cursor-editor cursor-agent origin)

case "${1:-}" in
"" | --check) ;;
*)
  echo "${0##*/}: unknown option '${1}'. Try --help." >&2
  exit 2
  ;;
esac

if (( $# > 1 )); then
  echo "${0##*/}: unknown option '${2}'. Try --help." >&2
  exit 2
fi

outcome=$(mktemp)
trap 'rm -f "$outcome"' EXIT
export OMARCHY_VENDOR_OUTCOME=$outcome

worst=0
for product in "${CURSOR_PRODUCTS[@]}"; do
  "omarchy-update-${product}" "$@"
  rc=$?
  if (( rc > worst )); then
    worst=$rc
  fi
done

if [[ ! -s $outcome ]]; then
  exit 0
fi

n_absent=0
n_updated=0
n_current=0
n_stale=0
n_foreign=0
n_other=0
while IFS=$'\t' read -r _id out _have _latest; do
  case $out in
  absent) n_absent=$((n_absent + 1)) ;;
  updated) n_updated=$((n_updated + 1)) ;;
  current) n_current=$((n_current + 1)) ;;
  stale) n_stale=$((n_stale + 1)) ;;
  foreign) n_foreign=$((n_foreign + 1)) ;;
  *) n_other=$((n_other + 1)) ;;
  esac
done <"$outcome"

if (( n_updated == 0 && n_current == 0 && n_stale == 0 && n_foreign == 0 && n_other == 0 )); then
  exit 0
fi

parts=()
if (( n_updated > 0 )); then
  parts+=("$n_updated updated")
fi
if (( n_stale > 0 )); then
  parts+=("$n_stale newer")
fi
if (( n_current > 0 )); then
  parts+=("$n_current current")
fi
if (( n_absent > 0 )); then
  parts+=("$n_absent not installed")
fi
if (( n_foreign > 0 )); then
  parts+=("$n_foreign left alone")
fi
if (( n_other > 0 )); then
  parts+=("$n_other skipped")
fi

if (( ${#parts[@]} > 0 )); then
  summary=$(printf '%s, ' "${parts[@]}")
  echo "Cursor: ${summary%, }."
fi

exit "$worst"
