#!/bin/bash

# omarchy:summary=Install or update Cursor Agent from Cursor's official Linux tarball
# omarchy:name=cursor-agent
# omarchy:args=[--check]

set -euo pipefail
source omarchy-update-vendor

VENDOR_ID=cursor-agent
VENDOR_LABEL="Cursor Agent"
VENDOR_ICON=""
VENDOR_URL_ALLOW='^https://downloads\.cursor\.com/lab/[0-9]{4}\.[0-9]{2}\.[0-9]{2}-[A-Za-z0-9]+/linux/(x64|arm64)/agent-cli-package\.tar\.gz$'
VENDOR_INTEGRITY_FLOOR=pinned-url

ASDF_STUB_MARK='asdf:icholy/asdf-cursor-agent'
AGENT_VERSIONS="${XDG_DATA_HOME:-$HOME/.local/share}/cursor-agent/versions"
AGENT_LINK="$HOME/.local/bin/cursor-agent"

cursor_agent_is_asdf_stub() {
  local path=$1
  [[ -f $path ]] && grep -Fq "$ASDF_STUB_MARK" "$path"
}

vendor_arch() {
  case "$(uname -m)" in
  x86_64 | amd64) printf 'x64\n' ;;
  aarch64 | arm64) printf 'arm64\n' ;;
  *) return 1 ;;
  esac
}

vendor_installed() {
  local path

  if [[ -e $AGENT_LINK || -L $AGENT_LINK ]]; then
    if [[ ! -L $AGENT_LINK ]] && cursor_agent_is_asdf_stub "$AGENT_LINK"; then
      printf 'absent\n'
      return 0
    fi
    vendor_owned_symlink_version "$AGENT_LINK" "$AGENT_VERSIONS" cursor-agent
    return
  fi

  path=$(command -v cursor-agent 2>/dev/null || true)
  if [[ -n $path ]]; then
    if cursor_agent_is_asdf_stub "$path"; then
      printf 'absent\n'
      return 0
    fi
    printf 'foreign\t%s\tnot Omarchy'\''s install\n' "$path"
    return 0
  fi

  printf 'absent\n'
}

vendor_resolve() {
  local arch=$1
  local script version url

  script=$(curl -fsSL --retry 3 --retry-all-errors --max-time 20 \
    "https://cursor.com/install") || return 1

  if [[ $script =~ downloads\.cursor\.com/lab/([0-9]{4}\.[0-9]{2}\.[0-9]{2}-[A-Za-z0-9]+) ]]; then
    version=${BASH_REMATCH[1]}
    url="https://downloads.cursor.com/lab/${version}/linux/${arch}/agent-cli-package.tar.gz"
    printf 'version=%s\turl=%s\tintegrity=pinned-url\n' "$version" "$url"
    return 0
  fi

  return 1
}

vendor_apply() {
  local staging
  staging=$(vendor_extract_tarball "$1" cursor-agent) || return 1
  vendor_swap_versioned_dir "$staging" "$AGENT_VERSIONS/$2" "$AGENT_LINK" cursor-agent
}

omarchy_update_vendor "$@"
